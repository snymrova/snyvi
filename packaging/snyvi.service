[Unit]
Description=snyvi document viewer
Documentation=https://github.com/snymrova/snyvi

[Service]
Type=simple
ExecStart=/usr/bin/snyvi serve
# on-failure is also how `snyvi restart` works under this unit: the daemon
# exits 75 for a planned restart (see server.rs, PLANNED_RESTART_EXIT) and
# is started again from whatever file ExecStart names now. Do not add 75 to
# SuccessExitStatus, or a restart would be a stop.
Restart=on-failure
RestartSec=2
# A desk's panes are the daemon's children, and theirs are theirs. When the
# service stops, every one of them stops with it: processes never come back on
# their own, and a shell left running by a daemon that is gone is exactly that.
# control-group is systemd's default; it is written down so that nobody makes
# it `process` later without reading this.
KillMode=control-group

[Install]
WantedBy=default.target
